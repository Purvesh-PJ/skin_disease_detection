# Git and development
.git
.gitignore
.github
.vscode

# Python virtualenvs and caches
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
app.log

# Node & Frontend build artifacts
node_modules/
build/

# Machine Learning Heavy Data & Notebooks (prevent sending multi-GB training images into build context)
ml_engine/data/
ml_engine/notebooks/
*.ipynb

# Local model weights cache (prevent copying local heavy binary weights directly into image context)
trained_models/*.zip
uploads/
