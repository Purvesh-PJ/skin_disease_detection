# =================================================================
# SKIN DISEASE DETECTION - BACKEND ENVIRONMENT VARIABLES
# =================================================================

# Server Network Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# Security & CORS
FLASK_SECRET_KEY=dev_default_secret_key_123
CORS_ORIGINS=*

# Local Model Directory (relative to repo root or absolute path)
MODEL_DIR=trained_models

# Cloud Storage Download URLs for AI Models (Default: Hugging Face Model Hub)
# Auto-downloads if model files are missing on fresh cloud containers
HUGGINGFACE_REPO_BASE=https://huggingface.co/purvesh-pj/skin-disease-ensemble/resolve/main
MODEL_URL_RESNET=https://huggingface.co/purvesh-pj/skin-disease-ensemble/resolve/main/resnet101.tflite
MODEL_URL_DENSENET=https://huggingface.co/purvesh-pj/skin-disease-ensemble/resolve/main/densenet121.tflite
MODEL_URL_EFFICIENTNET=https://huggingface.co/purvesh-pj/skin-disease-ensemble/resolve/main/efficientnetb3.tflite
