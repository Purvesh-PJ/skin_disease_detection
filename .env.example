# =================================================================
# SKIN DISEASE DETECTION - UNIFIED ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to '.env' in the project root directory and update
# the values according to your environment.
# 
# IMPORTANT: Never commit the actual '.env' file to version control!
# =================================================================

# -----------------------------------------------------------------
# BACKEND CONFIGURATION
# -----------------------------------------------------------------
# Secret key for Flask session security
FLASK_SECRET_KEY=change_this_to_a_secure_flask_secret_key_123!

# Secret key for signing and verifying JWT tokens
JWT_SECRET_KEY=change_this_to_a_secure_jwt_secret_key_456!

# MongoDB Connection URI
# Local MongoDB: mongodb://localhost:27017/skin_disease_db
# Cloud MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/skin_disease_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/skin_disease_db

# Optional Database Name override (if not specified in MONGO_URI)
MONGO_DB_NAME=skin_disease_db

# Allowed CORS Origins (comma-separated origins or * for development)
# Production Example: https://your-frontend-domain.vercel.app
CORS_ORIGINS=*

# Flask Server Port & Host Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# Directory path where trained .h5 model files are stored
# Default: trained_models (at project root)
MODEL_DIR=trained_models

# Optional Cloud Storage Direct Download URL for trained models ZIP file
# If models are missing locally, backend will automatically download and extract them on first start.
MODEL_ZIP_URL=


# -----------------------------------------------------------------
# FRONTEND CONFIGURATION (React - process.env.REACT_APP_*)
# -----------------------------------------------------------------
# Base URL for the Backend API endpoints
# Local: http://localhost:5000
# Production Example: https://your-backend-api.onrender.com
REACT_APP_API_URL=http://localhost:5000
