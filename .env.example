# =================================================================
# SKIN DISEASE DETECTION - ENVIRONMENT VARIABLES GUIDE
# =================================================================

# =================================================================
# 🚀 1. PRODUCTION / DEPLOYMENT VARIABLES (FOR VERCEL & RENDER/RAILWAY)
# =================================================================

# -----------------------------------------------------------------
# [FRONTEND] Set on Vercel -> Project Settings -> Environment Variables
# -----------------------------------------------------------------
# Backend API URL (Replace with your Render/Railway backend URL once deployed)
REACT_APP_API_URL=https://your-backend-api.onrender.com

# -----------------------------------------------------------------
# [BACKEND] Set on Render / Railway / Server Environment Variables
# -----------------------------------------------------------------
# Production Security Secrets
FLASK_SECRET_KEY=prod_flask_secret_key_change_me
JWT_SECRET_KEY=prod_jwt_secret_key_change_me

# MongoDB Atlas Connection String
MONGO_DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skin_disease_db?retryWrites=true&w=majority
MONGO_DB_NAME=skin_disease_db

# Allowed CORS Origins (Set your Vercel URL to allow requests)
CORS_ORIGINS=https://your-frontend.vercel.app

# Cloud Storage Download URL for AI Models (Default: Hugging Face Model Registry)
# Auto-downloads if model files are missing on fresh cloud containers
HUGGINGFACE_REPO_BASE=https://huggingface.co/purvesh-pj/skin-disease-ensemble/resolve/main
MODEL_URL_RESNET=https://huggingface.co/purvesh-pj/skin-disease-ensemble/resolve/main/resnet101.h5
MODEL_URL_DENSENET=https://huggingface.co/purvesh-pj/skin-disease-ensemble/resolve/main/densenet121.h5
MODEL_URL_EFFICIENTNET=https://huggingface.co/purvesh-pj/skin-disease-ensemble/resolve/main/efficientnetb3.h5


# =================================================================
# 💻 2. LOCAL DEVELOPMENT VARIABLES (FOR LOCAL TESTING)
# =================================================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True
MODEL_DIR=trained_models
