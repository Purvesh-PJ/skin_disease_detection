# =================================================================
# SKIN DISEASE DETECTION - ENVIRONMENT VARIABLES GUIDE
# =================================================================

# =================================================================
# 💻 1. LOCAL DEVELOPMENT CONFIGURATION
# =================================================================
# [BACKEND] (Used when running 'python backend/main.py' or loaded from root .env)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True
FLASK_SECRET_KEY=dev_default_secret_key_123
CORS_ORIGINS=*
MODEL_DIR=trained_models

# [FRONTEND] (Pre-configured out-of-the-box in frontend/.env.development)
# Zero manual setup required for local development!
# React automatically connects to http://localhost:5000.
# If running your backend on a custom port, override in frontend/.env.local:
# REACT_APP_API_URL=http://localhost:5000


# =================================================================
# 🚀 2. PRODUCTION / DEPLOYMENT VARIABLES (VERCEL & RENDER)
# =================================================================
# [FRONTEND] Set in Vercel -> Project Settings -> Environment Variables
REACT_APP_API_URL=https://your-backend-api.onrender.com

# [BACKEND] Set in Render -> Service Settings -> Environment Variables
# Production Security Secrets
# FLASK_SECRET_KEY=prod_flask_secret_key_change_me
# CORS_ORIGINS=https://your-frontend.vercel.app

# Cloud Storage Download URLs for AI Models (Default: Hugging Face Model Hub)
# Auto-downloads if model files are missing on fresh cloud containers
# HUGGINGFACE_REPO_BASE=https://huggingface.co/purvesh-pj/skin-disease-ensemble/resolve/main
# MODEL_URL_RESNET=https://huggingface.co/purvesh-pj/skin-disease-ensemble/resolve/main/resnet101.tflite
# MODEL_URL_DENSENET=https://huggingface.co/purvesh-pj/skin-disease-ensemble/resolve/main/densenet121.tflite
# MODEL_URL_EFFICIENTNET=https://huggingface.co/purvesh-pj/skin-disease-ensemble/resolve/main/efficientnetb3.tflite
